{
  "name": "laju-go",
  "version": "1.0.0",
  "description": "Quest Multimedia starter - Go Fiber, React, Inertia.js, and SQLite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:go": "air",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:go\"",
    "dev:background": "node scripts/dev.mjs background",
    "dev:status": "node scripts/dev.mjs status",
    "dev:stop": "node scripts/dev.mjs stop",
    "dev:logs": "node scripts/dev.mjs logs",
    "dev:restart": "node scripts/dev.mjs stop && node scripts/dev.mjs background",
    "build": "vite build",
    "build:all": "vite build && go build -o laju-go ./cmd/laju-go",
    "build:go": "go build -o laju-go ./cmd/laju-go",
    "build:linux": "cross-env GOOS=linux GOARCH=amd64 go build -o laju-go ./cmd/laju-go",
    "serve": "go run ./cmd/laju-go",
    "db:refresh": "rimraf ./data/app.db ./data/app.db-shm ./data/app.db-wal ./data/cache",
    "db:migrate": "go run github.com/pressly/goose/v3/cmd/goose@latest -dir migrations sqlite3 ./data/app.db up",
    "db:migrate:status": "go run github.com/pressly/goose/v3/cmd/goose@latest -dir migrations sqlite3 ./data/app.db status",
    "db:migrate:down": "go run github.com/pressly/goose/v3/cmd/goose@latest -dir migrations sqlite3 ./data/app.db down",
    "db:migrate:create": "go run github.com/pressly/goose/v3/cmd/goose@latest -dir migrations sqlite3 create",
    "db:generate": "sqlc generate",
    "verify": "npm run typecheck && npm run build && go build ./cmd/laju-go && go vet ./... && go test ./...",
    "typecheck": "tsc --noEmit --project frontend/tsconfig.json"
  },
  "author": "Maulana Shalihin",
  "license": "MIT",
  "dependencies": {
    "@inertiajs/react": "^3.0.0",
    "axios": "^1.13.6",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "lucide-react": "^1.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@inertiajs/vite": "^3.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  }
}
